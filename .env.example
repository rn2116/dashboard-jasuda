# Firebase Realtime Database — WAJIB diisi
# Ambil dari: Firebase Console → Project Settings → General → Your apps → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.<region>.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# (Opsional) Database secret untuk write ter-authenticated dari server.
# Ambil dari: Firebase Console → Realtime Database → ⋮ → Database secrets
# FIREBASE_DB_SECRET=
